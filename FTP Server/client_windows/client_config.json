{
  "_comment": "chassis_following FTP 压测客户端配置 (Windows)。命令行参数优先覆盖本文件。host 已预填为本机 FTP 服务端地址。",

  "host": "172.16.8.200",
  "port": 2121,
  "user": "stress",
  "password": "stress123",

  "concurrency": 4,
  "rounds": 3,
  "files": 50,
  "timeout": 30,
  "log_level": "INFO",

  "download": {
    "remote_dir": "/",
    "pattern": "*.jpg",
    "work_dir": "%TEMP%\\ftp_stress_dl"
  },

  "upload": {
    "remote_dir": "/stress_uploads",
    "size": "1M",
    "payload": "random"
  },

  "both": {
    "remote_dir": "/stress_uploads",
    "size": "1M",
    "payload": "random"
  },

  "fetch": {
    "remote_dir": "/",
    "pattern": "*.jpg",
    "local_dir": "%USERPROFILE%\\Downloads\\shots",
    "skip_existing": true
  },

  "out_json": "%TEMP%\\ftp_stress_report.json"
}
