# 扫拍任务。模式在 chassis_following.yaml 的 sweep_mode，上层不选。
# sweep_mode=1 或 2 时用 task_id、vehicle_type、speed；sweep_mode=0 时这三项可空。
# speed：底盘速度，米/秒。sweep_from=rear 时接到任务车尾在 0，沿行走方向增加。
# sweep_from=front 时机器人在车头，车尾在前方。
# 执行中 /chassis_following/pause 暂停：速度记为 0 并取消导航，任务不结束。
# /chassis_following/continue 恢复原速度，重新导航，按剩余点位接着拍。
# 节点不再订阅夹爪位置。
string task_id
string vehicle_type
float64 speed
---
# 回到 map_home 之后的最终结果。success 表示回家到位。
bool success
string message
# 本趟车型启用检测点相邻间隔的均值，米。不足两个点、模式 0、或开扫被拒绝时为 0。
float64 point_interval
---
# 每拍成一组发一次；三种模式在扫拍结束、开始回家时再发一次。此时还没到 home。
bool sweep_ok
string message
uint32 shot_count
string run_dir
# 这一组 TCP 拍摄请求里的追踪号。左腕以 _L 结尾，右腕以 _R 结尾。没拍的一侧为空。开始回家的两条都为空。
string trace_id_L
string trace_id_R
